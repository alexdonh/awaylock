    "No idle lock or display sleep while your device is in range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Sperre und kein Ruhezustand des Displays bei Inaktivität, solange dein Gerät in Reichweite ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin bloqueo ni reposo de pantalla por inactividad mientras tu dispositivo esté al alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
