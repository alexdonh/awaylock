    "Pick a device you keep with you. Your Mac locks when it goes out of range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Gerät, das du bei dir trägst. Dein Mac sperrt sich, wenn es außer Reichweite ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un dispositivo que lleves contigo. Tu Mac se bloquea cuando queda fuera de alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un appareil que vous gardez sur vous. Votre Mac se verrouille quand il est hors de portée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un dispositivo che porti sempre con te. Il Mac si blocca quando esce dalla portata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身につけているデバイスを選んでください。範囲外になると Mac がロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 지니고 다니는 기기를 선택하세요. 기기가 범위를 벗어나면 Mac이 잠깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um dispositivo que você leva consigo. Seu Mac é bloqueado quando ele sai do alcance."
