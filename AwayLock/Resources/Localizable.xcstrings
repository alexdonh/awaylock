    "Your data stays on this Mac. The only network request is a daily update check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf diesem Mac. Die einzige Netzwerkanfrage ist eine tägliche Suche nach Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en este Mac. La única solicitud de red es una comprobación diaria de actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données restent sur ce Mac. La seule requête réseau est une recherche quotidienne de mises à jour."
