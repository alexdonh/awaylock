    "Enters your login password after your device is back in range for 3 seconds. Requires Accessibility access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt dein Anmeldepasswort ein, wenn dein Gerät 3 Sekunden wieder in Reichweite ist. Erfordert Zugriff auf Bedienungshilfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu contraseña cuando tu dispositivo lleva 3 segundos de vuelta en el alcance. Requiere acceso de Accesibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisit votre mot de passe quand votre appareil est de retour à portée depuis 3 secondes. Nécessite l'accès Accessibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisce la password di login quando il dispositivo torna in portata da 3 secondi. Richiede l'accesso Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが範囲内に戻って 3 秒後にログインパスワードを入力します。アクセシビリティへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기가 범위 안으로 돌아오고 3초 후 로그인 암호를 입력합니다. 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita sua senha de login depois que o dispositivo volta ao alcance por 3 segundos. Requer acesso de Acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводит пароль входа, когда устройство 3 секунды снова в зоне действия. Требуется доступ к универсальному доступу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập mật khẩu đăng nhập khi thiết bị quay lại phạm vi được 3 giây. Cần quyền Trợ năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备回到范围内 3 秒后输入你的登录密码。需要辅助功能权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置回到範圍內 3 秒後輸入你的登入密碼。需要輔助使用權限。"
          }
        }
      }
    },
