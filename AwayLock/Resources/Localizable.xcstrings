            "state" : "needs_review",
            "value" : "致謝"
          }
        }
      }
    },
    "After a few seconds out of range, or as soon as the signal is lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ein paar Sekunden außer Reichweite oder sobald das Signal verloren geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras unos segundos fuera de alcance, o en cuanto se pierde la señal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après quelques secondes hors de portée, ou dès que le signal est perdu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo alcuni secondi fuori portata, o appena il segnale si perde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲外になって数秒後、または信号が途絶えた瞬間に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범위를 벗어나고 몇 초 뒤, 또는 신호가 끊기는 즉시."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após alguns segundos fora do alcance, ou assim que o sinal é perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через несколько секунд вне зоны действия или сразу при потере сигнала."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau vài giây ngoài phạm vi, hoặc ngay khi mất tín hiệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开范围几秒后，或在信号丢失的瞬间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開範圍幾秒後，或在訊號中斷時立即鎖定。"
          }
        }
      }
    },
    "After that, unlock yourself. One try per lock." : {
