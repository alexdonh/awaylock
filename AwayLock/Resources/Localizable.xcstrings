    "Couldn't lock. In Lock Screen settings, set Require password to Immediately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperren fehlgeschlagen. Stelle in den Einstellungen für den Sperrbildschirm Passwort anfordern auf Sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo bloquear. En los ajustes de Pantalla bloqueada, pon Solicitar contraseña en Inmediatamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillage impossible. Dans les réglages Écran verrouillé, réglez Exiger le mot de passe sur Immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile bloccare. Nelle impostazioni Schermata di blocco, imposta Richiedi password su Immediatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックできませんでした。「ロック画面」設定で「パスワードを要求」を「すぐに」にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠글 수 없습니다. 잠금 화면 설정에서 암호 요구를 즉시로 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível bloquear. Nos ajustes de Tela Bloqueada, defina Exigir senha como Imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось заблокировать. В настройках экрана блокировки установите для параметра «Запрашивать пароль» значение «Сразу»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khóa. Trong cài đặt Màn hình khóa, đặt Yêu cầu mật khẩu thành Ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法锁定。请在“锁定屏幕”设置中将“需要密码”设为“立即”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法鎖定。請在「鎖定畫面」設定中將「要求密碼」設為「立即」。"
          }
        }
      }
    },
