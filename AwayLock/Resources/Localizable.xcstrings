    "Off by default. Someone could relay your device's Bluetooth signal to make it seem near." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aus. Jemand könnte das Bluetooth-Signal deines Geräts weiterleiten, damit es nah erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por omisión. Alguien podría retransmitir la señal Bluetooth de tu dispositivo para que parezca cercano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut. Quelqu'un pourrait relayer le signal Bluetooth de votre appareil pour le faire paraître proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato per impostazione predefinita. Qualcuno potrebbe ritrasmettere il segnale Bluetooth del dispositivo per farlo sembrare vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトはオフです。第三者がデバイスの Bluetooth 信号を中継して、近くにあるように見せかける可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 끔입니다. 누군가 기기의 Bluetooth 신호를 중계해 가까이 있는 것처럼 보이게 할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por padrão. Alguém poderia retransmitir o sinal Bluetooth do seu dispositivo para que ele pareça próximo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. Злоумышленник может ретранслировать Bluetooth-сигнал устройства, чтобы оно казалось рядом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định tắt. Người khác có thể chuyển tiếp tín hiệu Bluetooth của thiết bị để giả như nó ở gần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。他人可能中继你设备的蓝牙信号，使其看起来在附近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為關閉。他人可能轉送你裝置的藍牙訊號，讓它看起來就在附近。"
          }
        }
      }
    },
