{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ stopped broadcasting or changed its Bluetooth address. Your previous device is still in use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sendet nicht mehr oder hat seine Bluetooth-Adresse geändert. Dein vorheriges Gerät bleibt aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dejó de emitir o cambió su dirección Bluetooth. Se sigue usando tu dispositivo anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a cessé d'émettre ou a changé d'adresse Bluetooth. Votre appareil précédent reste utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha smesso di trasmettere o ha cambiato indirizzo Bluetooth. Il dispositivo precedente resta in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が信号の送信を停止したか、Bluetooth アドレスが変わりました。以前のデバイスを引き続き使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 신호 송출을 멈췄거나 Bluetooth 주소가 바뀌었습니다. 이전 기기를 계속 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ parou de transmitir ou mudou o endereço Bluetooth. Seu dispositivo anterior continua em uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перестало передавать сигнал или сменило Bluetooth-адрес. Используется прежнее устройство."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã ngừng phát tín hiệu hoặc đổi địa chỉ Bluetooth. Thiết bị trước đó vẫn được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已停止广播或更改了蓝牙地址。仍在使用之前的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已停止廣播或變更了藍牙位址。仍在使用先前的裝置。"
          }
        }
      }
    },
