{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ stopped broadcasting or changed its Bluetooth address. Your previous device is still in use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sendet nicht mehr oder hat seine Bluetooth-Adresse geändert. Dein vorheriges Gerät bleibt aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dejó de emitir o cambió su dirección Bluetooth. Se sigue usando tu dispositivo anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a cessé d'émettre ou a changé d'adresse Bluetooth. Votre appareil précédent reste utilisé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が信号の送信を停止したか、Bluetooth アドレスが変わりました。以前のデバイスを引き続き使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 신호 송출을 멈췄거나 Bluetooth 주소가 바뀌었습니다. 이전 기기를 계속 사용합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã ngừng phát tín hiệu hoặc đổi địa chỉ Bluetooth. Thiết bị trước đó vẫn được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已停止广播或更改了蓝牙地址。仍在使用之前的设备。"
          }
        }
      }
    },
    "%lld dBm" : {
      "shouldTranslate" : false
    },
