          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось заблокировать. В настройках экрана блокировки установите для параметра «Запрашивать пароль» значение «Сразу»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khóa. Trong cài đặt Màn hình khóa, đặt Yêu cầu mật khẩu thành Ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法锁定。请在“锁定屏幕”设置中将“需要密码”设为“立即”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法鎖定。請在「鎖定畫面」設定中將「要求密碼」設為「立即」。"
          }
        }
      }
    },
