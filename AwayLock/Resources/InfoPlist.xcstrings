{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock liest die Signalstärke des gewählten Geräts, um deinen Mac zu sperren, wenn du weggehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock lee la intensidad de señal del dispositivo que elijas para bloquear tu Mac cuando te alejes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock lit la puissance du signal de l'appareil choisi pour verrouiller votre Mac quand vous vous éloignez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock legge la potenza del segnale del dispositivo scelto per bloccare il Mac quando ti allontani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock は選択したデバイスの信号強度を読み取り、離れたときに Mac をロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock은 선택한 기기의 신호 강도를 읽어 자리를 뜨면 Mac을 잠급니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AwayLock lê a intensidade do sinal do dispositivo escolhido para bloquear seu Mac quando você se afasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock считывает уровень сигнала выбранного устройства, чтобы блокировать Mac, когда вы уходите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock đọc cường độ tín hiệu của thiết bị bạn chọn để có thể khóa máy Mac khi bạn rời đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock 会读取你所选设备的信号强度，以便在你离开时锁定 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AwayLock 會讀取你所選裝置的訊號強度，以便在你離開時鎖定 Mac。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
