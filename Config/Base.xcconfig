// Shared settings. Fill the placeholders before shipping (M5).
// Put your team / signing identity in Config/Local.xcconfig (git-ignored):
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_IDENTITY = Developer ID Application
// Never change the bundle ID after the first release: Bluetooth/Accessibility grants
// and the Keychain password are tied to it.

AWAYLOCK_BUNDLE_ID = app.awaylock.mac
SU_FEED_URL = https:/$()/awaylock.app/appcast.xml
SU_PUBLIC_ED_KEY = gt/Nbi9tE9oxw+t9a0DrivS8ZUZ4jVTsoVDryDIVpdc=

MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 110

MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES


ALWAYS_SEARCH_USER_PATHS = NO

#include? "Local.xcconfig"
