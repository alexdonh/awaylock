{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby liest die Signalstärke des gewählten Geräts, um deinen Mac zu sperren, wenn du weggehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby lee la intensidad de señal del dispositivo que elijas para bloquear tu Mac cuando te alejes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby lit la puissance du signal de l’appareil choisi pour verrouiller votre Mac quand vous vous éloignez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby は選択したデバイスの信号強度を読み取り、離れたときに Mac をロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby는 선택한 기기의 신호 강도를 읽어 자리를 뜨면 Mac을 잠급니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby đọc cường độ tín hiệu của thiết bị bạn chọn để có thể khóa máy Mac khi bạn rời đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby 会读取你所选设备的信号强度，以便在你离开时锁定 Mac。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
