    "Couldn’t lock. Turn on “Require password immediately” in Lock Screen settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren fehlgeschlagen. Aktiviere „Passwort sofort anfordern“ in den Einstellungen für den Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo bloquear. Activa «Solicitar contraseña inmediatamente» en los ajustes de Pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage impossible. Activez « Exiger le mot de passe immédiatement » dans les réglages Écran verrouillé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックできませんでした。「ロック画面」設定で「パスワードを要求」を「すぐに」にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠글 수 없습니다. 잠금 화면 설정에서 ‘암호 요구’를 ‘즉시’로 설정하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khóa. Hãy bật “Yêu cầu mật khẩu ngay lập tức” trong cài đặt Màn hình khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法锁定。请在“锁定屏幕”设置中将“需要密码”设为“立即”。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
