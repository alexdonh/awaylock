    "No idle lock or sleep while your key is nearby.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Sperre und kein Ruhezustand bei Inaktivität, solange dein Schlüssel in der Nähe ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin bloqueo ni reposo por inactividad mientras tu llave está cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni verrouillage ni veille pour inactivité tant que votre clé est à proximité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが近くにある間は、放置によるロックやスリープをしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 가까이 있는 동안에는 유휴 잠금이나 잠자기가 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tự khóa hay ngủ khi chìa khóa của bạn ở gần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙设备在附近时，不会因闲置而锁定或睡眠。"
          }
        }
      }
    },
    "Not seen near yet · %@": {
      "localizations": {
