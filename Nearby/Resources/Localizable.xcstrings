    "The display won’t idle off while your device is close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm schaltet sich nicht wegen Inaktivität aus, solange dein Gerät in der Nähe ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla no se apaga por inactividad mientras tu dispositivo esté cerca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran ne s’éteint pas pour inactivité tant que votre appareil est proche"
