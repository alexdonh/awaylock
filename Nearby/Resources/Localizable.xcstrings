{
  "sourceLanguage": "en",
  "strings": {
    "%@ stopped advertising or changed its address. Nearby kept your previous choice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sendet nicht mehr oder hat seine Adresse geändert. Nearby hat deine vorherige Auswahl beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dejó de emitir o cambió su dirección. Nearby mantuvo tu elección anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a cessé d’émettre ou a changé d’adresse. Nearby a conservé votre choix précédent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のアドバタイズが止まったか、アドレスが変わりました。Nearby は以前の選択を維持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기기가 신호 송출을 멈췄거나 주소가 바뀌었습니다. Nearby는 이전 선택을 유지했습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã ngừng phát tín hiệu hoặc đổi địa chỉ. Nearby giữ lựa chọn trước đó của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止广播或更改了地址。Nearby 保留了你之前的选择。"
          }
        }
      }
    },
    "%lld dBm": {
      "shouldTranslate": false
    },
    "%lld devices hidden because their Bluetooth address keeps changing.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Gerät ausgeblendet, weil sich seine Bluetooth-Adresse ständig ändert."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Geräte ausgeblendet, weil sich ihre Bluetooth-Adresse ständig ändert."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld device hidden because its Bluetooth address keeps changing."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld devices hidden because their Bluetooth address keeps changing."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dispositivo oculto porque su dirección Bluetooth cambia constantemente."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dispositivos ocultos porque su dirección Bluetooth cambia constantemente."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld appareil masqué, car son adresse Bluetooth change sans cesse."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld appareils masqués, car leur adresse Bluetooth change sans cesse."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth アドレスが変わり続けるため、%lld 台のデバイスを非表示にしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 주소가 계속 바뀌어 기기 %lld개를 숨겼습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ẩn %lld thiết bị có địa chỉ Bluetooth liên tục thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏 %lld 个蓝牙地址不断变化的设备。"
          }
        }
      }
    },
