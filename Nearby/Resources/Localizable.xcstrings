    "Installs only while your device is near, so a restart never locks you out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert nur, wenn dein Gerät in der Nähe ist – ein Neustart sperrt dich so nie aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se instala con tu dispositivo cerca, así un reinicio nunca te deja fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe uniquement quand votre appareil est proche, pour qu’un redémarrage ne vous bloque jamais"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが近くにあるときだけインストールするので、再起動で締め出されることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 가까이 있을 때만 설치하므로 재시동 때문에 잠기지 않습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cài khi thiết bị ở gần, nên việc khởi động lại sẽ không khóa bạn ở ngoài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在设备靠近时安装，因此重启绝不会把你锁在外面"
          }
        }
      }
    },
    "Keep Mac awake": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac wach halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac activo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Mac éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac をスリープさせない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 깨어 있게 유지"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ máy Mac luôn thức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 唤醒"
          }
        }
      }
    },
    "Keep this device with you. When it walks away, your Mac locks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag dieses Gerät bei dir. Wenn es sich entfernt, sperrt sich dein Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva este dispositivo contigo. Cuando se aleje, tu Mac se bloqueará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez cet appareil sur vous. Quand il s’éloigne, votre Mac se verrouille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを身につけておいてください。離れると Mac がロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 몸에 지니세요. 기기가 멀어지면 Mac이 잠깁니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mang thiết bị này theo người. Khi nó rời đi, máy Mac sẽ khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随身携带此设备。它离开时，你的 Mac 就会锁定。"
          }
        }
      }
    },
