    "Walk away, it locks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weggehen, und er sperrt sich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te alejas y se bloquea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous partez, il se verrouille"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離れるとロック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자리를 뜨면 잠김"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rời đi là khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开即锁定"
          }
        }
      }
    },
    "While nearby": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Nähe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras está cerca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À proximité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにいる間"
          }
        },
        "ko": {
          "stringUnit": {
