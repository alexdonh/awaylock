            "value": "가까이 있을 때"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ở gần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在附近时"
          }
        }
      }
    },
    "Your Apple Watch, iPhone or a Bluetooth band.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apple Watch, dein iPhone oder ein Bluetooth-Armband."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple Watch, iPhone o una pulsera Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple Watch, iPhone ou un bracelet Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone、または Bluetooth バンド。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, iPhone 또는 Bluetooth 밴드."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, iPhone hoặc vòng đeo Bluetooth của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Apple Watch、iPhone 或蓝牙手环。"
          }
        }
      }
    },
    "Your Mac locks itself when you walk away, and stays unlocked while you’re close.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac sperrt sich, wenn du weggehst, und bleibt entsperrt, solange du in der Nähe bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac se bloquea cuando te alejas y sigue desbloqueado mientras estás cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac se verrouille quand vous vous éloignez et reste déverrouillé tant que vous êtes à proximité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離れると Mac が自動でロックし、近くにいる間はロック解除のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자리를 뜨면 Mac이 자동으로 잠기고, 가까이 있는 동안에는 잠금 해제 상태를 유지합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac tự khóa khi bạn rời đi và luôn mở khóa khi bạn ở gần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你离开时 Mac 自动锁定，你在附近时保持解锁。"
          }
        }
      }
    },
