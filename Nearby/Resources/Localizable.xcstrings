          "stringUnit": {
            "state": "translated",
            "value": "Gibt dein Anmeldepasswort ein, wenn du 3 s wieder in Reichweite bist. Benötigt Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tu contraseña tras 3 s de vuelta en el alcance. Requiere Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisit votre mot de passe après 3 s de retour à portée. Nécessite l’accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲内に戻って 3 秒後にログインパスワードを入力します。アクセシビリティが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위 안으로 돌아오고 3초 후 로그인 암호를 입력합니다. 손쉬운 사용 권한이 필요합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mật khẩu đăng nhập sau 3 giây quay lại phạm vi. Cần quyền Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到范围内 3 秒后输入你的登录密码。需要辅助功能权限。"
          }
        }
      }
    },
