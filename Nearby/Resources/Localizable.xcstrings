    "Listening… Devices show up after they’ve been heard for 10 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche … Geräte erscheinen, nachdem sie 10 Sekunden lang empfangen wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… Los dispositivos aparecen tras detectarse durante 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute… Les appareils apparaissent après avoir été détectés pendant 10 secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索中… デバイスは 10 秒間検出されると表示されます。"
          }
        },
        "ko": {
