    "Bluetooth off or no reading counts as away": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth aus oder kein Messwert zählt als entfernt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth desactivado o sin lectura cuenta como lejos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth désactivé ou aucune mesure compte comme éloigné"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth オフや信号なしは離れたとみなします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth가 꺼지거나 신호가 없으면 멀어진 것으로 간주"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt Bluetooth hoặc không đọc được tín hiệu đều tính là đã rời đi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙关闭或读不到信号都视为已离开"
          }
        }
      }
    },
